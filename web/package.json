{
  "name": "athanor-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/web --target web --no-opt --no-pack --profile web --out-dir ../../web/src/wasm",
    "wasm:dev": "wasm-pack build ../crates/web --target web --no-pack --dev --out-dir ../../web/src/wasm",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "diff": "9.0.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
